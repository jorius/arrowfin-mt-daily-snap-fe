NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=http://localhost:3001

# Socket.IO client reconnection back-off: first retry delay and the cap it grows to (ms).
NEXT_PUBLIC_WS_RECONNECT_DELAY_MS=1000
NEXT_PUBLIC_WS_RECONNECT_DELAY_MAX_MS=5000
# How long the widget waits without a connection before it marks the figures as stale (ms).
NEXT_PUBLIC_WS_STALE_AFTER_MS=5000
